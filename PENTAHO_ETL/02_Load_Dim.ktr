  <step>
    <name>Modified JavaScript value</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Pengecekan apakah date_key valid dan tidak kosong
if (date_key == null) {
    var YEAR = null;
    var d = null;
    var MONTH = null;
    var DAY = null;
    var QUARTER = null;
    var month_name = null;
    var day_of_week = null;
} else {
    var d = new Date(date_key.getTime());
    
    // Mengekstrak bagian-bagian waktu
    var YEAR = d.getFullYear();
    var MONTH = d.getMonth() + 1; // getMonth() dimulai dari 0 (Januari = 0)
    var DAY = d.getDate();
    
    // Menghitung Kuartal (Quarter: 1 sampai 4)
    var QUARTER = Math.ceil(MONTH / 3);
    
    // Nama Bulan
    var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    var month_name = months[d.getMonth()];
    
    // Nama Hari (Day of Week)
    var days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    var day_of_week = days[d.getDay()];
}</jsScript_script>
      </jsScript>
    </jsScripts>
